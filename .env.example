# Generate with: openssl rand -base64 32
# WARNING: if this key is lost, every capsule body in the database is unrecoverable. Keep the production
# value in the deployment secret store only -- never commit it.
MUDDA_MASTER_KEY=bXVkZGEtbG9jYWwtZGV2LW1hc3Rlci1rZXktMzJieXQ=

