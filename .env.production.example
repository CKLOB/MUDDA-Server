# Copy this file to .env.production on the VM and replace every REPLACE_WITH_* value.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
TZ=Asia/Seoul
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0 -XX:InitialRAMPercentage=25.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Seoul

DB_HOST=postgres
DB_PORT=5432
DB_NAME=mudda
DB_USERNAME=mudda_prod
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=5000

REDIS_HOST=redis
REDIS_PORT=6379

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_KEY=REPLACE_WITH_AWS_SECRET_KEY
MEDIA_STORAGE_BUCKET=REPLACE_WITH_PRIVATE_S3_BUCKET
MEDIA_UPLOAD_URL_EXPIRATION=10m
MEDIA_ACCESS_URL_EXPIRATION=5m
MEDIA_MAX_IMAGE_SIZE=10485760
MEDIA_MAX_VOICE_SIZE=20971520
MEDIA_MAX_VIDEO_SIZE=104857600

# Generate and back up this value separately. Losing it makes existing envelope-encrypted data unreadable.
MUDDA_MASTER_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

OAUTH_KAKAO_CLIENT_ID=REPLACE_WITH_KAKAO_CLIENT_ID
OAUTH_KAKAO_CLIENT_SECRET=REPLACE_WITH_KAKAO_CLIENT_SECRET
OAUTH_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
OAUTH_GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
OAUTH_APPLE_CLIENT_ID=REPLACE_WITH_APPLE_CLIENT_ID
OAUTH_APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
OAUTH_APPLE_KEY_ID=REPLACE_WITH_APPLE_KEY_ID
OAUTH_APPLE_PRIVATE_KEY=REPLACE_WITH_APPLE_PRIVATE_KEY

FCM_ENABLED=false
FCM_CREDENTIALS=file:/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_DIR=/opt/mudda/secrets

MEDIA_PENDING_RETENTION=1d
MEDIA_CLEANUP_CRON=0 0 4 * * *
CAPSULE_KEY_SHARE_CLEANUP_CRON=0 30 4 * * *
CAPSULE_OPEN_RADIUS_METER=100
CAPSULE_MAX_ACTIVE_PER_MEMBER=100
CAPSULE_MAX_EXPIRATION_YEARS=10
CAPSULE_MAX_NEARBY_RADIUS_METER=5000
